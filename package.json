{
  "name": "count-ludo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Clean, minimal, browser-based Ludo. Play free vs AI or local friends. No ads, no signup.",
  "license": "MIT",
  "homepage": "https://github.com/KarthikSubramanian07/Count-Ludo",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/KarthikSubramanian07/Count-Ludo.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run test:run && npm run build",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=count-ludo"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "^9.20.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.0.5",
    "wrangler": "^4.118.0"
  },
  "overrides": {
    "undici": "^7.29.0"
  }
}
